---
BasedOnStyle: Google
Standard: c++20
IndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 100
PointerAlignment: Left
DerivePointerAlignment: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
InsertBraces: true
IncludeBlocks: Regroup
IncludeCategories:
  # The file's own directory headers ("wire/frame.h"), then vendored, then the C and C++ libraries.
  - Regex: '^"'
    Priority: 1
  - Regex: '^<(doctest|nlohmann|httplib|picosha2)'
    Priority: 2
  - Regex: '^<.*\.h>'
    Priority: 3
  - Regex: '^<'
    Priority: 4
...
